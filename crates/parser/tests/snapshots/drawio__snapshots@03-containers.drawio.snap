---
source: tests/drawio.rs
expression: "pages.iter().map(|p| (&p.name, &p.diagram)).collect::<Vec<_>>()"
input_file: tests/fixtures/drawio/03-containers.drawio
---
- - Services
  - kind: drawio
    nodes:
      - id: svc
        label: Order service
      - id: worker
        label: Worker
        shape: circle
      - id: client
        label: Client
      - id: note
        label: Remember to scale workers
        shape: text
    edges:
      - id: call
        from: client
        to: svc
        label: HTTPS
        stroke: dotted
        head: circle
        both_ends: true
        length: 1
      - id: enqueue
        from: svc
        to: worker
        stroke: thick
        head: none
        length: 1
    groups:
      - id: backend
        title: Back end
        nodes:
          - svc
      - id: jobs
        title: Workers
        nodes:
          - worker
        parent: backend
    layout:
      backend:
        x: 200
        y: 40
        width: 400
        height: 300
      client:
        x: 20
        y: 80
        width: 100
        height: 50
      jobs:
        x: 380
        y: 160
        width: 200
        height: 160
      note:
        x: 20
        y: 300
        width: 160
        height: 30
      svc:
        x: 220
        y: 80
        width: 120
        height: 60
      worker:
        x: 420
        y: 210
        width: 80
        height: 80
