---
- - Overview
  - kind: drawio
    nodes:
      - id: api
        label: Orders API
        shape: rounded
      - id: db
        label: Commerce DB
        shape: cylinder
    edges:
      - id: e1
        from: api
        to: db
        label: writes
        stroke: normal
        head: arrow
        length: 1
    layout:
      api:
        x: 80
        y: 120
        width: 120
        height: 60
      db:
        x: 320
        y: 110
        width: 80
        height: 80
- - Details
  - kind: drawio
    nodes:
      - id: svc
        label: Order service
      - id: worker
        label: Worker
        shape: circle
      - id: client
        label: Client
      - id: note
        label: Remember to scale workers
        shape: text
    edges:
      - id: call
        from: client
        to: svc
        label: HTTPS
        stroke: dotted
        head: circle
        both_ends: true
        length: 1
      - id: enqueue
        from: svc
        to: worker
        stroke: thick
        head: none
        length: 1
    groups:
      - id: backend
        title: Back end
        nodes:
          - svc
      - id: jobs
        title: Workers
        nodes:
          - worker
        parent: backend
    layout:
      backend:
        x: 200
        y: 40
        width: 400
        height: 300
      client:
        x: 20
        y: 80
        width: 100
        height: 50
